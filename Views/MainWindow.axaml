<Window
    x:Class="Calc.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Calc.ViewModels"
    Title="Calc"
    Width="400"
    Height="650"
    d:DesignHeight="400"
    d:DesignWidth="650"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at
            App.axaml.cs)
        -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid
        Margin="10"
        ColumnDefinitions="*,*,*,*"
        RowDefinitions="0.5*,*,*,*,*,*,*">
        <!--  Sub Text  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            FontSize="30"
            FontWeight="Thin"
            Text="{Binding SubText}"
            TextWrapping="Wrap" />
        <!--  Main Text  -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            FontSize="48"
            FontWeight="Normal"
            Text="{Binding MainText}"
            TextWrapping="Wrap" />
        <!--  Control Buttons  -->
        <Button
            Grid.Row="2"
            Grid.Column="0"
            Classes="ctl normal"
            Command="{Binding ClearCommand}"
            Content="C"
            HotKey="Delete" />
        <Button
            Grid.Row="2"
            Grid.Column="1"
            Classes="ctl normal"
            Command="{Binding DeleteCommand}"
            Content="Del"
            HotKey="Back" />
        <Button
            Grid.Row="6"
            Grid.Column="3"
            Classes="ctl normal"
            Command="{Binding EvaluateCommand}"
            Content="="
            HotKey="Enter" />
        <!--  Number Buttons  -->
        <Button
            Grid.Row="5"
            Grid.Column="0"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="1"
            Content="1"
            HotKey="D1" />
        <Button
            Grid.Row="5"
            Grid.Column="1"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="2"
            Content="2"
            HotKey="D2" />
        <Button
            Grid.Row="5"
            Grid.Column="2"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="3"
            Content="3"
            HotKey="D3" />
        <Button
            Grid.Row="4"
            Grid.Column="0"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="4"
            Content="4"
            HotKey="D4" />
        <Button
            Grid.Row="4"
            Grid.Column="1"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="5"
            Content="5"
            HotKey="D5" />
        <Button
            Grid.Row="4"
            Grid.Column="2"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="6"
            Content="6"
            HotKey="D6" />
        <Button
            Grid.Row="3"
            Grid.Column="0"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="7"
            Content="7"
            HotKey="D7" />
        <Button
            Grid.Row="3"
            Grid.Column="1"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="8"
            Content="8"
            HotKey="D8" />
        <Button
            Grid.Row="3"
            Grid.Column="2"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="9"
            Content="9"
            HotKey="D9" />
        <Button
            Grid.Row="6"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="0"
            Content="0"
            HotKey="D0" />
        <!--  Symbol Button  -->
        <Button
            Grid.Row="6"
            Grid.Column="2"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="."
            Content="."
            HotKey="Decimal" />
        <Button
            Grid.Row="2"
            Grid.Column="2"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="%"
            Content="%"
            HotKey="Shift+D5" />
        <!--  Operator Buttons  -->
        <Button
            Grid.Row="2"
            Grid.Column="3"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="÷"
            Content="÷"
            HotKey="Divide" />
        <Button
            Grid.Row="3"
            Grid.Column="3"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="×"
            Content="×"
            HotKey="Multiply" />
        <Button
            Grid.Row="4"
            Grid.Column="3"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="-"
            Content="-"
            HotKey="Subtract" />
        <Button
            Grid.Row="5"
            Grid.Column="3"
            Classes="normal"
            Command="{Binding AddCommand}"
            CommandParameter="+"
            Content="+"
            HotKey="Add" />
    </Grid>
</Window>
